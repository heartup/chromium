[
  Exposed=Window,
  RuntimeEnabled=JSONWebSocketHook
] interface JSONWebSocketController {
  void enableHook(DOMString websocketUrl);
  void disableHook();
  boolean isHookEnabled();
  DOMString getWebSocketUrl();
};
